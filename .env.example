# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Use a long, random value in local and production environments
JWT_SECRET="replace-this-with-a-long-random-secret"

# Ethereal SMTP settings (optional for local testing; signup remains successful if email delivery fails)
ETHEREAL_HOST="smtp.ethereal.email"
ETHEREAL_PORT=587
ETHEREAL_USER=""
ETHEREAL_PASS=""

PORT=3000
