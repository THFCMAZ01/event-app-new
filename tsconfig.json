{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "Node16",
    "moduleResolution": "Node16",          // ← Fixed mismatch
    "target": "ES2022",                    // Updated from es2020
    "types": ["node"],                     // Better than empty array

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Modern TS + Elysia/Prisma compatibility
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "prisma/**/*.ts"                       // Allow Prisma-related TS files
  ],
  "exclude": [
    "node_modules",
    "dist",
    "prisma.config.ts",                    // ← Critical fix for TS6059
    ".prisma",
    "prisma/migrations"
  ]
}